# =============================================================================
# Stage 1: Build the runner server binary
# =============================================================================
FROM golang:1.27-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /out/runner ./cmd/runner-firecracker.ee

# =============================================================================
# Stage 2: Download Firecracker binaries
# =============================================================================
FROM debian:bookworm-slim AS firecracker-binaries

ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

# The version and checksum come from the same pin file the host installer
# (scripts/firecracker.ee/install-runner-host.sh) sources: the host creates the
# golden snapshot, this image restores it, and Firecracker cannot restore a
# snapshot taken by a newer version.
COPY scripts/firecracker.ee/firecracker-release.sh /tmp/firecracker-release.sh
RUN set -eux; \
    test "${TARGETARCH}" = "amd64"; \
    bash /tmp/firecracker-release.sh install /opt/firecracker/bin

# =============================================================================
# Stage 3: Firecracker runner image
# =============================================================================
FROM debian:bookworm-slim AS runner

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        iproute2 \
        iptables \
        sudo \
        tini \
        util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/runner /usr/local/bin/sandbox-runner
COPY --from=firecracker-binaries /opt/firecracker/bin /opt/firecracker/bin

RUN mkdir -p /var/sandboxes /srv/jailer /srv/firecracker/template /srv/firecracker/snapshots

ENV SANDBOX_RUNNER_DATA_DIR=/var/sandboxes
ENV SANDBOX_RUNNER_LISTEN_ADDR=:8080
ENV SANDBOX_RUNNER_FIRECRACKER_JAILER_BIN=/opt/firecracker/bin/jailer
ENV SANDBOX_RUNNER_FIRECRACKER_BIN=/opt/firecracker/bin/firecracker
ENV SANDBOX_RUNNER_FIRECRACKER_JAILER_BASE_DIR=/srv/jailer
ENV SANDBOX_RUNNER_FIRECRACKER_TEMPLATE_DIR=/srv/firecracker/template
ENV SANDBOX_RUNNER_FIRECRACKER_SNAPSHOT_MEM_PATH=/srv/firecracker/snapshots/mem
ENV SANDBOX_RUNNER_FIRECRACKER_SNAPSHOT_STATE_PATH=/srv/firecracker/snapshots/state

EXPOSE 8080 9091

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/sandbox-runner"]
