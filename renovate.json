{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only the pins in the sandbox image are enrolled: sandbox-workspace/package.json and the global typescript in Dockerfile.sandbox.",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "custom.regex"],
  "npm": {
    "managerFilePatterns": ["/^sandbox-workspace/package\\.json$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile\\.sandbox$/"],
      "matchStrings": ["npm install -g typescript@(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "typescript",
      "datasourceTemplate": "npm"
    }
  ]
}
