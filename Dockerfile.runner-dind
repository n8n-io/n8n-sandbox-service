# =============================================================================
# Stage 1: Build the runner server binary
# =============================================================================
FROM golang:1.27-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /out/runner ./cmd/runner-docker

FROM docker:29.9.3-dind-alpine3.24@sha256:7bf70dcb85c822e3fa6f2d332143e474b99147b9d7b39102b0cfe8b04a7dd61b AS runner

# The base image no longer ships xfsprogs; start-runner.sh needs mkfs.xfs for
# the disk-quota storage pool.
#
# The runner needs only dockerd, the docker CLI and docker-init, which
# sandboxes run under (--init). ctr and the buildx and compose plugins go
# unused, but each carries its own outdated Go dependencies.
RUN apk upgrade --no-cache \
    && apk add --no-cache tini xfsprogs \
    && rm /usr/local/bin/ctr \
        /usr/local/libexec/docker/cli-plugins/docker-buildx \
        /usr/local/libexec/docker/cli-plugins/docker-compose

COPY --from=builder /out/runner /usr/local/bin/sandbox-runner
COPY scripts/start-runner.sh /usr/local/bin/start-runner.sh

RUN chmod +x /usr/local/bin/start-runner.sh \
    && mkdir -p /var/sandboxes

ENV SANDBOX_RUNNER_DATA_DIR=/var/sandboxes
ENV SANDBOX_RUNNER_LISTEN_ADDR=:8080
ENV SANDBOX_RUNNER_DOCKER_HOST=unix:///var/run/docker.sock

EXPOSE 8080

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/start-runner.sh"]
